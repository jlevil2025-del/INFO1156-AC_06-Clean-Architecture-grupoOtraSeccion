{
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "..",
    "testRegex": "tests/.*\\.spec\\.ts$",
    "moduleNameMapper": {
        "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageReporters": ["cobertura", "text", "lcov"],
    "collectCoverageFrom": [
        "src/posts/**/*.ts",
        "!src/posts/**/*.d.ts",
        "!src/posts/feed-ranking.strategy.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
        "global": {
            "branches": 70,
            "lines": 70
        }
    }
}
